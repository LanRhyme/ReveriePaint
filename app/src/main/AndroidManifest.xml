<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      graphics-core 1.1.0-beta01 把自己的 minSdk 抬到 24 (1.0.4 是 21), 项目 minSdk 仍是 23。
      这里显式放行: 该库只在前缓冲低延迟路径上使用, 而那条路径被 FrontBufferProbe.isSupported()
      (API 29+) 与 CanvasView/overlay 的挂载条件双重拦住, API 23 设备不会加载它的任何类。
      若将来改成全局引用, 请把 minSdk 直接抬到 24。
    -->
    <uses-sdk tools:overrideLibrary="androidx.graphics.core" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="com.oplus.ipemanager.permission.receiver.DOUBLE_CLICK" />
    <uses-permission android:name="com.oplus.ocs.permission.third" />
    <uses-permission android:name="com.oplus.permission.safe.IOT" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <queries>
        <package android:name="com.xiaomi.touchservice" />
        <package android:name="com.coloros.ocs.opencapabilityservice" />
        <package android:name="com.oplus.ocs" />
        <package android:name="com.oplus.ipemanager" />
        <package android:name="net.huanci.hsjpro" />
        <package android:name="com.huawei.stylus" />
        <package android:name="com.huawei.stylus.penengine" />
        <package android:name="com.huawei.stylus.floatmenu" />
        <package android:name="com.huawei.penengine" />
        <package android:name="com.huawei.penkit" />
        <package android:name="com.hihonor.stylus" />
        <package android:name="com.hihonor.featurelayer.sharedfeature.stylus" />
        <package android:name="com.hihonor.penkit" />
        <!-- vivo/iQOO 手写笔: penwrite = 手势/书写振动服务宿主, penalgoengine = 形状识别服务 -->
        <package android:name="com.vivo.penwrite" />
        <package android:name="com.vivo.penalgoengine" />
    </queries>

    <application
        android:name=".ReverieApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ReveriePaint"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReveriePaint">
        <uses-library android:name="vendor.oplus.hardware.touch-V1" android:required="false" />
        <meta-data
            android:name="com.oplus.ocs.ipepencil.AUTH_CODE"
            android:value="ATBFAiEA2FKyTQgEPDCvkD3iAtqkxi9B+cRRZxf0MBIyW7y9bCQCIBr6z6/TC8HcOdGx0BdlD0LgwzsY0H1qCmU+Gni98yiqcLhVZ4AAAAA=" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 分享单个文件 / 图片到应用 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-krita" />
                <data android:mimeType="application/x-krita-paintoppreset" />
                <data android:mimeType="application/x-krita-bundle" />
                <data android:mimeType="application/x-krita-resourcebundle" />
                <data android:mimeType="application/x-photoshop-brush" />
                <data android:mimeType="image/vnd.adobe.photoshop" />
                <data android:mimeType="image/x-psd" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 批量分享文件 / 图片到应用 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 文件管理器关联打开工程文件、笔刷与图片 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.kpp" />
                <data android:pathPattern=".*\\.bundle" />
                <data android:pathPattern=".*\\.abr" />
                <data android:pathPattern=".*\\.gbr" />
                <data android:pathPattern=".*\\.gih" />
            </intent-filter>

            <!-- 三星 S Pen 隔空操作(Air Actions)协议声明。
                 intent-filter 与 meta-data 缺一不可: 系统扫描应用列表靠 intent-filter
                 识别支持隔空操作的应用, 只有 meta-data 时应用不会出现在隔空操作列表里 -->
            <intent-filter>
                <action android:name="com.samsung.android.support.REMOTE_ACTION" />
            </intent-filter>
            <meta-data
                android:name="com.samsung.android.support.REMOTE_ACTION"
                android:resource="@xml/remote_action" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".core.stylus.HuaweiStylusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.huawei.stylus.action.BUTTON_DOUBLE_PRESSED" />
                <action android:name="com.huawei.stylus.action.DOUBLE_CLICK" />
                <action android:name="com.huawei.android.stylus.action.BUTTON_DOUBLE_PRESSED" />
                <action android:name="com.huawei.stylus.action.DOUBLE_TAP" />
                <action android:name="com.huawei.intent.action.STYLUS_BUTTON_CLICK" />
                <action android:name="huawei.intent.action.STYLUS_BUTTON_CLICK" />
                <action android:name="com.huawei.stylus.action.BUTTON_CLICK" />
                <action android:name="com.huawei.stylus.action.BUTTON_PRESSED" />
                <action android:name="com.huawei.action.STYLUS_DOUBLE_CLICK" />
                <action android:name="huawei.intent.action.STYLUS_DOUBLE_CLICK" />
                <action android:name="com.huawei.pencil.action.DOUBLE_CLICK" />
                <action android:name="com.huawei.nearlink.action.STYLUS_DOUBLE_CLICK" />
                <action android:name="com.huawei.stylus.action.SQUEEZE" />
                <action android:name="com.huawei.stylus.action.PINCH" />
                <action android:name="com.huawei.pencil.action.SQUEEZE" />
                <action android:name="com.huawei.nearlink.action.STYLUS_SQUEEZE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".core.stylus.HonorStylusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hihonor.stylus.action.STYLUS_DOUBLE_CLICK" />
                <action android:name="com.hihonor.android.stylus.action.BUTTON_DOUBLE_PRESSED" />
                <action android:name="com.hihonor.stylus.action.DOUBLE_CLICK" />
                <action android:name="com.hihonor.stylus.action.DOUBLE_TAP" />
                <action android:name="com.hihonor.intent.action.STYLUS_BUTTON_CLICK" />
            </intent-filter>
        </receiver>

        <!-- Creation Stats Dashboard Widget (4x2) -->
        <receiver
            android:name=".ui.widget.CreationStatsDashboardWidgetReceiver"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_dashboard_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/creation_stats_dashboard_widget_info" />
        </receiver>

        <!-- Creation Stats Compact Widget (2x2) -->
        <receiver
            android:name=".ui.widget.CreationStatsCompactWidgetReceiver"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/creation_stats_compact_widget_info" />
        </receiver>

        <!-- Recent Project Showcase Dashboard Widget (4x2) -->
        <receiver
            android:name=".ui.widget.RecentProjectDashboardWidgetReceiver"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_recent_dashboard_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_project_dashboard_widget_info" />
        </receiver>

        <!-- Recent Project Compact Artwork Frame Widget (2x2) -->
        <receiver
            android:name=".ui.widget.RecentProjectCompactWidgetReceiver"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/widget_recent_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_project_compact_widget_info" />
        </receiver>
    </application>

</manifest>
