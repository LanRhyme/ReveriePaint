Qt 6.6 的 qatomic.h 链不再传递包含 qglobal.h, 而该头文件只包含 QAtomicPointer
却使用了 Q_DISABLE_COPY, 导致以它为第一个 Qt 头文件的编译单元直接报
"unknown type name 'Q_DISABLE_COPY'" (例如 lcms2engine 的 CmykU16ColorSpace.cpp)
---
 libs/global/kis_lockless_stack.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libs/global/kis_lockless_stack.h b/libs/global/kis_lockless_stack.h
index 99cf26c4..ed06a61c 100644
--- a/libs/global/kis_lockless_stack.h
+++ b/libs/global/kis_lockless_stack.h
@@ -18,6 +18,7 @@
 #define __KIS_LOCKLESS_STACK_H
 
 #include <QAtomicPointer>
+#include <QtGlobal>
 
 template<class T>
 class KisLocklessStack
