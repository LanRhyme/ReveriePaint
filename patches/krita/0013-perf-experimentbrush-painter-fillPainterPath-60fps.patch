+                fillPainter->fillRectNoCompose(fillRect, pattern, patternTransform);
+            }
+            break;
+        case FillStyleGenerator:
+            if (generator) { // if the user hasn't got any generators, we shouldn't crash...
+                fillPainter->fillRect(fillRect.x(), fillRect.y(), fillRect.width(), fillRect.height(), q->generator());
+            }
+            break;
+        default:
+            break;
         }
-        break;
     }
 
     if (polygonMaskImage.isNull() || (maskPainter == 0)) {
         polygonMaskImage = QImage(maskImageWidth, maskImageHeight, QImage::Format_ARGB32_Premultiplied);
         maskPainter = new QPainter(&polygonMaskImage);
-        maskPainter->setRenderHint(QPainter::Antialiasing, q->antiAliasPolygonFill());
     }
+    maskPainter->setRenderHint(QPainter::Antialiasing, q->antiAliasPolygonFill());
 
-    // Break the mask up into chunks so we don't have to allocate a potentially very large QImage.
-    const QColor black(Qt::black);
     const QBrush brush(Qt::white);
+    quint8 maskRow[256];
+
+    // Break the mask up into chunks so we don't have to allocate a potentially very large QImage.
     for (qint32 x = fillRect.x(); x < fillRect.x() + fillRect.width(); x += maskImageWidth) {
         for (qint32 y = fillRect.y(); y < fillRect.y() + fillRect.height(); y += maskImageHeight) {
+            const qint32 chunkWidth = qMin(fillRect.x() + fillRect.width() - x, maskImageWidth);
+            const qint32 chunkHeight = qMin(fillRect.y() + fillRect.height() - y, maskImageHeight);
+            const QRect chunkRect(x, y, chunkWidth, chunkHeight);
 
-            polygonMaskImage.fill(black.rgb());
+            if (requestedRegion && !requestedRegion->intersects(chunkRect)) {
+                continue;
+            }
+
+            if (chunkWidth == maskImageWidth && chunkHeight == maskImageHeight) {
+                polygonMaskImage.fill(0);
+            } else {
+                const size_t rowBytes = size_t(chunkWidth) * sizeof(QRgb);
+                for (int r = 0; r < chunkHeight; ++r) {
+                    memset(polygonMaskImage.scanLine(r), 0, rowBytes);
+                }
+            }
+
+            maskPainter->setClipRect(0, 0, chunkWidth, chunkHeight);
             maskPainter->translate(-x, -y);
             maskPainter->fillPath(path, brush);
             maskPainter->translate(x, y);
+            maskPainter->setClipping(false);
 
-            qint32 rectWidth = qMin(fillRect.x() + fillRect.width() - x, maskImageWidth);
-            qint32 rectHeight = qMin(fillRect.y() + fillRect.height() - y, maskImageHeight);
+            const QRegion chunkActiveRegion = requestedRegion ? (*requestedRegion & chunkRect) : QRegion(chunkRect);
+            for (const QRect &subRect : chunkActiveRegion) {
+                if (subRect.isEmpty()) {
+                    continue;
+                }
 
-            KisHLineIteratorSP lineIt = polygon->createHLineIteratorNG(x, y, rectWidth);
+                KisHLineIteratorSP lineIt = polygon->createHLineIteratorNG(subRect.x(), subRect.y(), subRect.width());
+                const int localX = subRect.x() - x;
+                const int localY = subRect.y() - y;
 
-            quint8 tmp;
-            for (int row = y; row < y + rectHeight; row++) {
-                QRgb* line = reinterpret_cast<QRgb*>(polygonMaskImage.scanLine(row - y));
-                do {
-                    tmp = qRed(line[lineIt->x() - x]);
-                    polygon->colorSpace()->applyAlphaU8Mask(lineIt->rawData(), &tmp, 1);
-                } while (lineIt->nextPixel());
-                lineIt->nextRow();
-            }
+                for (int row = 0; row < subRect.height(); ++row) {
+                    const QRgb *line = reinterpret_cast<const QRgb *>(polygonMaskImage.constScanLine(localY + row)) + localX;
+                    for (int col = 0; col < subRect.width(); ++col) {
+                        maskRow[col] = static_cast<quint8>(qRed(line[col]));
+                    }
 
+                    int col = 0;
+                    while (col < subRect.width()) {
+                        const qint32 n = qMin<qint32>(lineIt->nConseqPixels(), subRect.width() - col);
+                        quint8 *dst = lineIt->rawData();
+                        if (isSolidColorFill) {
+                            if (pixelSize == 4) {
+                                quint32 *dst32 = reinterpret_cast<quint32 *>(dst);
+                                for (qint32 i = 0; i < n; ++i) {
+                                    dst32[i] = solidColorU32;
+                                }
+                            } else {
+                                const quint8 *srcData = solidColor.data();
+                                for (qint32 i = 0; i < n; ++i) {
