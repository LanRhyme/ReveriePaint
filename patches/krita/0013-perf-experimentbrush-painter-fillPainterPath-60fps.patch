+                        cs->applyAlphaU8Mask(dst, maskRow + col, n);
+                        col += n;
+                        if (col < subRect.width()) {
+                            lineIt->nextPixels(n);
+                        }
+                    }
+                    lineIt->nextRow();
+                }
+
+                q->bitBlt(subRect.x(), subRect.y(), polygon, subRect.x(), subRect.y(), subRect.width(), subRect.height());
+            }
