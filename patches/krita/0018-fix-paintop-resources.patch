1. KisLocalStrokeResources.cpp: LocalResourcesSource 按值持有 QList<KoResourceSP>, 修复资源切换时的悬垂引用 SIGBUS
2. kis_texture_option.cpp: 遍历通道改用 channels.size() 替代 pixelSize() 并补充空指针防御, 修复涂抹/纹理笔刷越界 SIGSEGV
3. kis_hairy_paintop.cpp: 构造时补充 brush/painter/dab 空指针防御, 修复缺省笔尖时初始化毛发笔刷崩溃
---
 libs/resources/KisLocalStrokeResources.cpp         | 2 +-
 plugins/paintops/hairy/kis_hairy_paintop.cpp       | 9 ++++++++-
 plugins/paintops/libpaintop/kis_texture_option.cpp | 7 ++++---
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/libs/resources/KisLocalStrokeResources.cpp b/libs/resources/KisLocalStrokeResources.cpp
index 9eac480e..ffd0295a 100644
--- a/libs/resources/KisLocalStrokeResources.cpp
+++ b/libs/resources/KisLocalStrokeResources.cpp
@@ -63,7 +63,7 @@ public:
 
 private:
     const QString m_resourceType;
-    const QList<KoResourceSP> &m_cachedResources;
+    const QList<KoResourceSP> m_cachedResources;
 };
 }
 
diff --git a/plugins/paintops/hairy/kis_hairy_paintop.cpp b/plugins/paintops/hairy/kis_hairy_paintop.cpp
index e59bfcf8..99d019d0 100644
--- a/plugins/paintops/hairy/kis_hairy_paintop.cpp
+++ b/plugins/paintops/hairy/kis_hairy_paintop.cpp
@@ -46,6 +46,11 @@ KisHairyPaintOp::KisHairyPaintOp(const KisPaintOpSettingsSP settings, KisPainter
     KisBrushOptionProperties brushOption;
     brushOption.readOptionSetting(settings, settings->resourcesInterface(), settings->canvasResourcesInterface());
     KisBrushSP brush = brushOption.brush();
+    if (!brush || !painter || !painter->device()) {
+        loadSettings();
+        m_brush.setProperties(&m_properties);
+        return;
+    }
     KisFixedPaintDeviceSP dab = cachedDab(painter->device()->compositionSourceColorSpace());
 
     // properly initialize fake paint information to avoid warnings
@@ -59,7 +64,9 @@ KisHairyPaintOp::KisHairyPaintOp(const KisPaintOpSettingsSP settings, KisPainter
         brush->mask(dab, painter->paintColor(), KisDabShape(), fakePaintInformation);
     }
 
-    m_brush.fromDabWithDensity(dab, m_hairyBristleOption.densityFactor * 0.01);
+    if (dab) {
+        m_brush.fromDabWithDensity(dab, m_hairyBristleOption.densityFactor * 0.01);
+    }
     m_brush.setInkColor(painter->paintColor());
 
     loadSettings();
diff --git a/plugins/paintops/libpaintop/kis_texture_option.cpp b/plugins/paintops/libpaintop/kis_texture_option.cpp
index 9a101ee2..42de38a2 100644
--- a/plugins/paintops/libpaintop/kis_texture_option.cpp
+++ b/plugins/paintops/libpaintop/kis_texture_option.cpp
@@ -280,7 +280,7 @@ void KisTextureOption::applyGradient(KisFixedPaintDeviceSP dab, const QPoint& of
 void KisTextureOption::apply(KisFixedPaintDeviceSP dab, const QPoint &offset, const KisPaintInformation & info)
 {
     if (!m_enabled) return;
-    if (!m_maskInfo->isValid()) return;
+    if (!dab || !dab->colorSpace() || !m_maskInfo || !m_maskInfo->isValid()) return;
 
     if (m_texturingMode == KisTextureOptionData::LIGHTNESS) {
         applyLightness(dab, offset, info);
@@ -292,6 +292,7 @@ void KisTextureOption::apply(KisFixedPaintDeviceSP dab, const QPoint &offset, co
     }
 
     QRect rect = dab->bounds();
+    if (rect.isEmpty()) return;
     KisPaintDeviceSP mask = m_maskInfo->mask();
     const QRect maskBounds = m_maskInfo->maskBounds();
 
@@ -316,8 +317,8 @@ void KisTextureOption::apply(KisFixedPaintDeviceSP dab, const QPoint &offset, co
     int alphaChannelOffset = -1;
 
     const QList<KoChannelInfo *> channels = dab->colorSpace()->channels();
-    for (quint32 i = 0; i < dab->pixelSize(); i++) {
-        if (channels[i]->channelType() == KoChannelInfo::ALPHA) {
+    for (int i = 0; i < channels.size(); i++) {
+        if (channels[i] && channels[i]->channelType() == KoChannelInfo::ALPHA) {
             // TODO: check correctness for 16bits!
             alphaChannelOffset = channels[i]->pos()/* * channels[i]->size()*/;
             alphaChannelType = channels[i]->channelValueType();
