diff --git a/libs/image/tiles3/kis_memento_manager.cc b/libs/image/tiles3/kis_memento_manager.cc
index 1645e228..c62bd52f 100644
--- a/libs/image/tiles3/kis_memento_manager.cc
+++ b/libs/image/tiles3/kis_memento_manager.cc
@@ -262,12 +262,55 @@ KisMementoSP KisMementoManager::currentMemento() {
         for(iter=list.end(); iter-- != list.begin();)
 
 
+/**
+ * REVERIE: 按 memento 身份在 cancelled 列表里找对应的 revision。
+ *
+ * 上游的 rollforward()/rollback() 直接 takeFirst()/takeLast(), 只用
+ * KIS_SAFE_ASSERT_RECOVER_NOOP 做"应该对得上"的自检 —— Release 下只有一条
+ * qWarning, 于是只要有不进撤销栈的"本地事务"(预览/暂存回滚/取消的笔画)碰过同一台
+ * 设备, 历史就会错位:
+ *
+ *   - KisMementoManager::getMemento() 会 m_cancelledRevisions.clear(), 重做信息
+ *     没了, 但 KUndo2QStack 的重做区还留着命令;
+ *   - KisTransaction::revert() 会 rollback() 出一条本地 revision 并 prepend 进
+ *     cancelled; 紧接着 ~KisTransactionData 调 purgeHistory(), 而它只查
+ *     m_revisions —— 于是这条 revision 留在 cancelled 里, 它唯一的强引用
+ *     (事务自己的 KisMementoSP) 一析构, KisMemento 就被释放, cancelled 里成了
+ *     悬垂指针。
+ *
+ * 之后任何一次 redo() 的 rollforward() 都会把这个悬垂 revision 当成重做目标:
+ * 瓦片被"滚进"文档(日志里"莫名其妙出现笔仙"就是这个), 并且
+ * `m_currentMemento = changeList.memento` 对已释放内存做 refcount, 在 commit() 的
+ * `m_currentMemento = 0` 处走到 KisMemento::~KisMemento 的 `delete[] m_oldDefaultPixel`,
+ * 拿垃圾指针 free() —— Android 上就是 scudo 的 SIGABRT。
+ *
+ * 因此这里改成按身份匹配: 对不上就不动历史, 让这次 undo/redo 变成 no-op,
+ * 宁可"什么都没发生"也不能把错位的瓦片装进文档。
+ */
+static int reverieFindCancelledRevision(const KisHistoryList &list, const KisMemento *memento)
+{
+    for (int i = 0; i < list.size(); ++i) {
+        if (list[i].memento == memento) return i;
+    }
+    return -1;
+}
+
 void KisMementoManager::rollback(KisTileHashTable *ht, KisMementoSP memento)
 {
     commit();
 
     if (! m_revisions.size()) return;
 
+    // REVERIE: 只有"历史头恰好就是这次要回滚的事务"时才回滚。错位时保持现状,
+    // 否则会把别的 revision 的瓦片撤销掉(画面上内容乱跳/消失)。
+    if (m_revisions.last().memento != memento.data()) {
+        warnKrita << "REVERIE: rollback() memento mismatch, history left untouched."
+                  << "revisions:" << m_revisions.size()
+                  << "index empty:" << m_index.isEmpty()
+                  << "cancelled:" << m_cancelledRevisions.size();
+        return;
+    }
+
     KisHistoryItem changeList = m_revisions.takeLast();
 
     // SANITY CHECK: the transaction's memento must be in sync with
@@ -325,6 +368,18 @@ void KisMementoManager::rollforward(KisTileHashTable *ht, KisMementoSP memento)
 
     if (!m_cancelledRevisions.size()) return;
 
+    // REVERIE: 重做目标必须是 cancelled 列表里真正属于这个事务的那条 revision。
+    // 上游直接 takeFirst(), 一旦重做区被本地事务污染(见上方注释), 就会把别的
+    // revision (甚至已释放的 KisMemento) 滚进文档。这里要求身份匹配且位于队首,
+    // 对不上就当这次重做无效。
+    const int cancelledIndex = reverieFindCancelledRevision(m_cancelledRevisions, memento.data());
+    if (cancelledIndex != 0) {
+        warnKrita << "REVERIE: rollforward() memento mismatch, redo state invalidated."
+                  << "cancelled:" << m_cancelledRevisions.size()
+                  << "matched index:" << cancelledIndex;
+        return;
+    }
+
     KisHistoryItem changeList = m_cancelledRevisions.takeFirst();
 
     // SANITY CHECK: the transaction's memento must be in sync with
@@ -356,6 +411,18 @@ void KisMementoManager::purgeHistory(KisMementoSP oldestMemento)
         commit();
     }
 
+    /**
+     * REVERIE: 已取消(在重做区)的 revision 不在 m_revisions 里, 上游实现走到
+     * findRevisionByMemento() 返回 -1 就直接 return —— 于是 cancelled 里留下一条
+     * 指向即将析构的 KisMemento 的悬垂指针。这里先按身份把它摘掉: 事务都要没了,
+     * 它对应的重做信息本来也就失效了。
+     */
+    for (int i = m_cancelledRevisions.size() - 1; i >= 0; --i) {
+        if (m_cancelledRevisions[i].memento == oldestMemento.data()) {
+            m_cancelledRevisions.removeAt(i);
+        }
+    }
+
     qint32 revisionIndex = findRevisionByMemento(oldestMemento);
     if (revisionIndex < 0) return;
 
